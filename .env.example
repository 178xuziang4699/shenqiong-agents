# ============================================================
# 环境变量模板：复制为 .env 后按需修改（cp .env.example .env）
# 原则：密钥只放环境变量，任何情况下不写进代码或 config/*.yaml
# ============================================================

# ---------- 存储 ----------
# 默认 SQLite；换 PostgreSQL 形如 postgresql://user:pass@127.0.0.1:5432/agent
# AP_DB_DSN=sqlite:///var/agent.db
# AP_DATA_DIR=var

# ---------- 工作区（工具与知识库允许访问的根目录）----------
AP_WORKSPACE=.

# ---------- 并发与超时（默认值即需求约束）----------
AP_MAX_WORKERS=5
AP_SUBTASK_TIMEOUT=300
AP_TOOL_TIMEOUT=30
AP_RETRY_MAX=3

# ---------- 人工确认 ----------
# prompt：终端交互确认（默认，生产建议）
# approve：自动放行（仅用于 demo / 自动化）
# reject：自动拒绝（用于验证拒绝分支）
# scripted：按 AP_CONFIRM_SCRIPT 顺序放行/拒绝，如 approve,approve,reject
AP_CONFIRM_MODE=prompt
AP_CONFIRM_SCRIPT=

# ---------- 快照保留 ----------
AP_SNAPSHOT_KEEP=200

# ---------- 日志 ----------
AP_LOG_LEVEL=INFO

# ---------- 接入私有大模型（Ollama / OpenAI 兼容）----------
# 最简单：在本机执行 ./run_ollama.sh，自动探测 Ollama 并挑最强 DeepSeek 模型。
# 也可以在项目根目录建 .env 后手工填下面几项，再 ./run.sh serve。
# Ollama 原生协议：填 http://127.0.0.1:11434
# OpenAI 兼容端点：填 http://127.0.0.1:11434/v1 或设 AP_LLM_PROVIDER=openai
# AP_LLM_BASE_URL=http://127.0.0.1:11434
# AP_LLM_PROVIDER=ollama
# AP_LLM_MODEL=                 # 留空 = 自动挑 DeepSeek 系列中参数规模最大的
# AP_LLM_AUTO_SELECT=1
# AP_LLM_API_KEY=               # Ollama 不需要；OpenAI 兼容端点才填（只从环境变量读）
# AP_LLM_TIMEOUT=180
# 运行中的 Web 界面也可以在「模型状态」条里直接填地址并连接，无需重启。

# ---------- 演示用故障注入（生产请保持为空）----------
# AP_INTERRUPT_ON_JOB=T4/j0
# AP_FAULT_TOOL=calc.word_count:1
# AP_FAULT_VALIDATION=T3:1

# ---------- 添加自己的 API（长期生效写法）----------
# 页面上「＋ 添加我的 API」填的密钥只在进程内存里，重启就失效；要固化就写这里：
# cp .env.example .env 后把下面四行的注释去掉并填入自己的值，再 ./run.sh serve
# AP_LLM_BASE_URL=https://api.deepseek.com/v1
# AP_LLM_API_KEY=sk-你的密钥
# AP_LLM_MODEL=deepseek-chat
# AP_LLM_PROVIDER=openai
# 其它服务商只需换 BASE_URL / MODEL：OpenAI 用 https://api.openai.com/v1 + gpt-4o-mini；
# 自建 vLLM / 一体机用 http://<IP>:8000/v1 + 实际模型名，协议都是 OpenAI 兼容。
# .env 由 config.load_dotenv 自动读取，且已存在的环境变量优先，不会被误覆盖。
